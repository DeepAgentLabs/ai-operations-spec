{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepagentlabs.github.io/ai-operations-spec/drafts/v0.4/workflow.schema.json",
  "title": "AI Operations Workflow Artifact Draft",
  "type": "object",
  "required": ["spec_version", "id", "name", "start_time", "steps"],
  "properties": {
    "spec_version": {"const": "0.4-draft"},
    "id": {"$ref": "#/$defs/id"},
    "workflow_id": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1},
    "start_time": {"$ref": "#/$defs/time"},
    "end_time": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
    "status": {"enum": ["running", "completed", "failed", "cancelled"]},
    "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
    "metrics": {"$ref": "#/$defs/metrics"},
    "chaos_events": {"type": "array", "items": {"$ref": "#/$defs/chaos_event"}},
    "evaluations": {"type": "array", "items": {"$ref": "#/$defs/evaluation"}},
    "agent_topology": {"type": "object"},
    "metadata": {"type": "object"},
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"}}
  },
  "additionalProperties": true,
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "time": {"type": "string", "format": "date-time"},
    "metrics": {
      "type": "object",
      "properties": {
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "latency": {"type": "number", "minimum": 0},
        "ttft": {"type": ["number", "null"], "minimum": 0},
        "cost": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": true
    },
    "step": {
      "type": "object",
      "required": ["id", "name", "type", "metrics"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1},
        "agent_name": {"type": ["string", "null"]}, "agent_role": {"type": ["string", "null"]}, "parent_step_id": {"type": ["string", "null"]},
        "handoff_from": {"type": ["string", "null"]}, "handoff_to": {"type": ["string", "null"]}, "provider": {"type": ["string", "null"]}, "model": {"type": ["string", "null"]},
        "metrics": {"$ref": "#/$defs/metrics"}, "metadata": {"type": "object"}, "extensions": {"type": "object"}
      },
      "additionalProperties": true
    },
    "chaos_event": {
      "type": "object",
      "required": ["id", "fault_type", "timestamp", "outcome", "message"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "fault_type": {"type": "string", "minLength": 1}, "step_id": {"type": ["string", "null"]}, "step_name": {"type": ["string", "null"]},
        "timestamp": {"$ref": "#/$defs/time"}, "outcome": {"enum": ["errored", "degraded", "delayed", "looped"]}, "message": {"type": "string"}, "detail": {"type": "object"}, "extensions": {"type": "object"}
      },
      "additionalProperties": true
    },
    "evaluation": {
      "type": "object",
      "required": ["id", "name", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "step_id": {"type": ["string", "null"]}, "status": {"enum": ["passed", "failed", "unknown"]},
        "score": {"type": ["number", "null"]}, "min_score": {"type": ["number", "null"]}, "max_score": {"type": ["number", "null"]}, "explanation": {"type": ["string", "null"]}, "detail": {"type": "object"}, "extensions": {"type": "object"}
      },
      "additionalProperties": true
    }
  }
}
