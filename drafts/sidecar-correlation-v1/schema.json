{
  "$defs": {
    "Correlation": {
      "additionalProperties": false,
      "description": "Host-supplied IDs of the exact trace span being supervised.",
      "properties": {
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "trace_id": {
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        },
        "span_id": {
          "minLength": 1,
          "title": "Span Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "trace_id",
        "span_id"
      ],
      "title": "Correlation",
      "type": "object"
    },
    "Decision": {
      "description": "The outcome of a single Decision Gate evaluation for one proposed\naction (tool call).\n\n`risk` is `None` only on the `on_sidecar_failure` path (core/sidecar.py)\n-- when the Sidecar itself errored before Policy/Risk ever ran, there is\nno risk classification to report, and reporting one would misrepresent\nwhat actually happened.\n\nv0.4 adds provenance fields for audit trail: `decision_point` (which\nboundary fired), `trigger_details` (tool/action + arguments), and\n`causal_link` (correlation to prior decisions). Escalation outcomes\n(PAUSE, ESCALATE) may populate `escalation_required`.\n\nFrozen: a `Decision` is a record of what was decided, not a value meant\nto be mutated after the fact.",
      "properties": {
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "ALLOW",
            "WARN",
            "BLOCK",
            "CHALLENGE",
            "REPLAN",
            "PAUSE",
            "ESCALATE"
          ],
          "title": "Status",
          "type": "string"
        },
        "risk": {
          "anyOf": [
            {
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Risk"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "decision_point": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Point"
        },
        "trigger_details": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Details"
        },
        "escalation_required": {
          "default": false,
          "title": "Escalation Required",
          "type": "boolean"
        },
        "causal_link": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causal Link"
        }
      },
      "required": [
        "status",
        "risk",
        "reason"
      ],
      "title": "Decision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Decision-time projection for authorized consumers; no tool arguments.",
  "properties": {
    "contract_version": {
      "const": "sidecar.correlation/1",
      "default": "sidecar.correlation/1",
      "title": "Contract Version",
      "type": "string"
    },
    "correlation": {
      "$ref": "#/$defs/Correlation"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "system_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "System Id"
    },
    "agent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Id"
    },
    "source_event_id": {
      "minLength": 1,
      "title": "Source Event Id",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "policy_version": {
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "tool_name": {
      "title": "Tool Name",
      "type": "string"
    },
    "boundary": {
      "title": "Boundary",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/Decision"
    }
  },
  "required": [
    "correlation",
    "task_id",
    "source_event_id",
    "timestamp",
    "policy_version",
    "tool_name",
    "boundary",
    "decision"
  ],
  "title": "DecisionEvidence",
  "type": "object"
}
